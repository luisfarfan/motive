+/* Call on the serialized output-control thread, never from output signals.
+ * False means no worker can access this output again. Reaping at this point
+ * waits only for a worker's return after its final atomic store, not network IO.
+ * Stock stop remains blocking during connect for compatibility; clients can
+ * defer stop until this procedure reports connecting=false. */
+static void get_thread_state(void *data, calldata_t *params)
+{
+	struct rtmp_stream *stream = data;
+	bool pending = connecting(stream);
+	bool running = pending || active(stream);
+	if (!pending && stream->connect_thread_valid) {
+		pthread_join(stream->connect_thread, NULL);
+		stream->connect_thread_valid = false;
+	}
+	if (!running && stream->send_thread_valid) {
+		pthread_join(stream->send_thread, NULL);
+		stream->send_thread_valid = false;
+	}
+	calldata_set_bool(params, "connecting", pending);
+	calldata_set_bool(params, "workers_active", running);
+}
